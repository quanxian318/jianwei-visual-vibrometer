#!/bin/sh
### BEGIN INIT INFO
# Provides:          vibmon
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: vision vibration meter
### END INIT INFO
DAEMON=/usr/bin/vibmond
PIDFILE=/run/vibmond.pid
LOG=/var/log/vibmond.log

case "$1" in
  start)
    echo "Starting vibmond"
    start-stop-daemon -S -b -m -p $PIDFILE -x /bin/sh -- -c "exec $DAEMON -c /etc/vibmon/vibmon.json >>$LOG 2>&1"
    ;;
  stop)
    echo "Stopping vibmond"
    start-stop-daemon -K -p $PIDFILE -s TERM --retry 5
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
