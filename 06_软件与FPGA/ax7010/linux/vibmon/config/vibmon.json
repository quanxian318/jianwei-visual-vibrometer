  "alarm": {"warn_peak_to_peak": 2.0, "alarm_peak_to_peak": 5.0, "buzzer": true},
  "voice": {"enabled": true, "volume": 40},
  "fan": {"mode": "auto", "on_temp_c": 40, "off_temp_c": 36, "pause_during_measurement": true},
  "storage": {"records_dir": "/home/root/vibmon/records"},
  "ui": {"enabled": true, "fbdev": "/dev/fb0", "touch_device": "auto", "swap_xy": false, "invert_x": false, "invert_y": false},
  "control_socket": "/run/vibmon.sock",
  "poweroff_on_shutdown": true,
  "points": {
