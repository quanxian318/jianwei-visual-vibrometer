{
  "device_id": "vibmon-01",
  "timezone_offset_min": 480,
  "hardware": {
    "carrier_ctrl_base": "0x44000000",
    "i2c_management_base": "0x44010000",
    "i2c_sensors_base": "0x44020000",
    "uart_nano_base": "0x44040000",
    "uart_printer_base": "0x44050000",
    "spi_sensors_base": "0x44060000",
    "devices": {}
  },
  "nano": {
    "baud": 115200,
    "flow_control": true,
    "request_timeout_ms": 300,
    "status_period_ms": 2000,
    "offline_reset_ms": 15000,
    "reset_pulse_ms": 100
  },
  "panel": {
    "brightness": 32,
    "encoder_counts_per_detent": 2,
    "encoder_reverse": false,
    "debounce_ms": 15,
    "long_press_ms": 3000,
    "encoder_filter_us": 200,
    "watchdog_ms": 3000
  },
  "light": {"pwm_hz": 20000, "percent": 100, "auto_on_measure": true},
  "laser": {"off_during_measurement": true},
  "power": {"warn_current_a": 4.2, "deny_current_a": 4.5, "alert_current_a": 4.5},
  "sensors": {
    "imu": {"enabled": true, "spi_hz": 1000000, "odr_hz": 240, "accel_range_g": 2, "gyro_range_dps": 250},
    "adxl345": {"enabled": false, "spi_hz": 1000000, "rate_code": 11, "range_g": 2},
    "tof": {"enabled": true, "timing_budget_ms": 50, "period_ms": 100, "distance_mode": "long"},
    "sht40": {"enabled": true, "period_ms": 1000}
  },
  "printer": {
    "enabled": true,
    "baud": 9600,
    "cts_flow_control": true,
    "power_on_wait_ms": 2000,
    "ready_timeout_ms": 5000,
    "cts_busy_timeout_ms": 10000,
    "min_off_ms": 3000,
    "status_query": "none",
    "ms_per_raster_row": 2,
    "finish_margin_ms": 1500,
    "raster_strip_rows": 24,
    "width_dots": 384,
    "feed_lines": 4
